# ── Network ──────────────────────────────────────────────────────────
DEPLOYMENT=baseSepolia                      # localhost | baseSepolia
RPC_URLS=https://base-sepolia.g.alchemy.com/v2/KEY,https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=                          # Etherscan v2 key (verifies on Basescan)

# ── Keys (testnet only; never commit real values) ───────────────────
DEPLOYER_PRIVATE_KEY=                       # deploys contracts, owns mock faucets/oracles
OWNER_PRIVATE_KEY=                          # "Rahim": signs createVault, approvals (demo scripts only)
AGENT_PRIVATE_KEY=                          # the agent's session key (server only)
GUARDIAN_PRIVATE_KEY=                       # "Mother": demo scripts only
EMPLOYER_PRIVATE_KEY=                       # simulated employer for the unattended run
GUARDIAN_ADDRESS=
AGENT_ADDRESS=
MOTHER_ADDRESS=
SCHOOL_ADDRESS=
ATTACKER_ADDRESS=                           # red-team target address

# ── Vault parameters at deploy time ─────────────────────────────────
COOLING_OFF_SEC=86400
TIMELOCK_SEC=3600
AGENT_TTL_DAYS=30

# ── Agent ────────────────────────────────────────────────────────────
MODEL_PROVIDER=anthropic                    # anthropic | offline
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
PLANNER_EFFORT=medium
SIM_RPC_URL=http://127.0.0.1:8546           # anvil --fork-url $RPC (started by the container)
SIM_FORK_URL=                               # same as the main RPC: reset the fork to latest before each simulation
ANCHOR_MODE=each                            # each | batch

# ── Server ───────────────────────────────────────────────────────────
PORT=8787
DB_PATH=data/baseSepolia.sqlite
ADMIN_TOKEN=change-me
WEB_URL=https://covenant.example.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
UNATTENDED=1                                # compressed payday/remittance cadence for the track record
UNATTENDED_WAGE=1000
INDEX_FROM=                                 # empty: a new database starts at the chain head; start: re-index from deployment
