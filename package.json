{
  "name": "covenant",
  "private": true,
  "version": "0.1.0",
  "description": "An AI wallet agent whose authority is bounded by an on-chain policy contract.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["contracts", "shared", "agent", "server", "web", "redteam"],
  "scripts": {
    "build:contracts": "npm -w contracts run build",
    "test": "npm -w contracts test && npm -w agent test && npm -w server test",
    "test:contracts": "npm -w contracts test",
    "coverage": "npm -w contracts run coverage",
    "node": "npm -w contracts run node",
    "deploy:local": "npm -w contracts run deploy:local",
    "deploy:base-sepolia": "npm -w contracts run deploy:base-sepolia",
    "server": "npm -w server start",
    "web": "npm -w web run dev",
    "redteam": "npm -w redteam start",
    "ledger": "node scripts/ledger.js",
    "demo:local": "node scripts/demo/run-local.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "licenses": "node scripts/check-licenses.js"
  }
}
